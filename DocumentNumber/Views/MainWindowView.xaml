<Window x:Class="DocumentNumber.Views.MainWindowView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dokumentenverwaltung"
        Height="520"
        Width="1100"
        MinHeight="400"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        FontFamily="Segoe UI"
        FontSize="12">

    <Window.Resources>

        <Style x:Key="FieldTextBox"
               TargetType="TextBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="BorderBrush" Value="#A0A0A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="FieldLabel"
               TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style x:Key="SectionTitle"
               TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style x:Key="ActionButton"
               TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- Hauptbereich -->
            <RowDefinition Height="*"/>

            <!-- Abstand -->
            <RowDefinition Height="10"/>

            <!-- Buttons unten -->
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <!-- Drei Spalten -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- ================================= -->
            <!-- LINKE SPALTE: DATEIEN             -->
            <!-- ================================= -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    Padding="10">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Dateien"
                               Style="{StaticResource SectionTitle}"/>

                    <ListBox x:Name="FilesListBox"
                             Grid.Row="1"
                             SelectionMode="Single"
                             BorderBrush="#C8C8C8"
                             BorderThickness="1"
                             Background="White"
                             ItemsSource="{Binding Documents}"
                             />

                    <Button x:Name="OpenButton"
                            Grid.Row="2"
                            Content="Ordner öffnen"
                            Height="32"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            Command="{Binding OpenFolderCommand}"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- ================================= -->
            <!-- MITTLERE SPALTE: METADATEN       -->
            <!-- ================================= -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    Padding="12">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="55"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <!-- Title -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Title"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Style="{StaticResource FieldTextBox}"
                                 Text="{Binding Title}"/>

                        <!-- Subject -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Subject"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Style="{StaticResource FieldTextBox}"
                                 Text="{Binding Subject}"/>


                        <!-- Author -->
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Author"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding Author}"
                                 Style="{StaticResource FieldTextBox}"/>


                        <!-- Keywords -->
                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="Keywords"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Text="{Binding Keywords}"
                                 Style="{StaticResource FieldTextBox}"/>



                        <!-- Comments -->
                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="Comments"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Text="{Binding Comments}"
                                 Style="{StaticResource FieldTextBox}"/>


                        <!-- Company -->
                        <TextBlock Grid.Row="5"
                                   Grid.Column="0"
                                   Text="Company"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Grid.Row="5"
                                 Grid.Column="1"
                                 Text="{Binding Company}"
                                 Style="{StaticResource FieldTextBox}"/>

                        <!-- Document Number -->
                        <TextBlock Grid.Row="6"
                                   Grid.Column="0"
                                   Text="Document Number"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Grid.Row="6"
                                 Grid.Column="1"
                                 Text="{Binding DocumentNumber}"
                                 Style="{StaticResource FieldTextBox}"/>


                        <!-- Revision -->
                        <TextBlock Grid.Row="7"
                                   Grid.Column="0"
                                   Text="Revision"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Grid.Row="7"
                                 Grid.Column="1"
                                 Text="{Binding Revision}"
                                 Style="{StaticResource FieldTextBox}"/>


                        <!-- Project Name -->
                        <TextBlock Grid.Row="8"
                                   Grid.Column="0"
                                   Text="Project Name"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox Grid.Row="8"
                                 Grid.Column="1"
                                 Text="{Binding ProjectName}"
                                 Style="{StaticResource FieldTextBox}"/>

                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- ================================= -->
            <!-- RECHTE SPALTE: DOKUMENTNUMMERN    -->
            <!-- ================================= -->
            <Border Grid.Column="4"
                    Background="White"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    Padding="10">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Dokumentennummern"
                               Style="{StaticResource SectionTitle}"/>

                    <ListBox x:Name="DocumentNumbersListBox"
                             Grid.Row="1"
                             SelectionMode="Single"
                             BorderBrush="#C8C8C8"
                             BorderThickness="1"
                             Background="White"
                             ItemsSource="{Binding DocumentNumbers}"
                             />
                </Grid>
            </Border>

        </Grid>

        <!-- ================================= -->
        <!-- UNTERER BUTTONBEREICH              -->
        <!-- ================================= -->
        <Border Grid.Row="2"
                Background="Transparent">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button x:Name="SaveButton"
                            Content="Speichern"
                            Style="{StaticResource ActionButton}"/>

                    <Button x:Name="CancelButton"
                            Content="Abbrechen"
                            Style="{StaticResource ActionButton}"/>

                    <Button x:Name="GenerateDocumentationButton"
                            Content="Generiere Doku#"
                            MinWidth="145"
                            Background="#DCEAF7"
                            BorderBrush="#8BAFD1"
                            Style="{StaticResource ActionButton}"/>

                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
